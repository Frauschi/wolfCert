# wolfCert CMake package config -- generated by autoconf (config.status) so
# that an autoconf `make install` is consumable via find_package(wolfCert),
# exactly like a native CMake install. Do not edit the generated file; edit
# cmake/Config.cmake.in instead.

include(CMakeFindDependencyMacro)

# wolfCert always links wolfSSL; resolve its imported target (wolfssl::wolfssl)
# from wolfSSL's own installed CMake package.
find_dependency(wolfssl)

include("${CMAKE_CURRENT_LIST_DIR}/wolfCertTargets.cmake")

# Note: check_required_components() is intentionally not called here -- it is
# provided by configure_package_config_file()'s @PACKAGE_INIT@ expansion, which
# only the native CMake build performs. wolfCert exposes no optional components.
